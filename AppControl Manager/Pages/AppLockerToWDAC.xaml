<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppControlManager.Pages.AppLockerToWDAC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    xmlns:applocker="using:AppControlManager.AppLockerPolicy">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status / progress -->
        <CCToolKit:WrapPanel Grid.Row="0" HorizontalAlignment="Center" HorizontalSpacing="15" VerticalSpacing="10">
            <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.MainInfoBar.IsOpen, Mode=TwoWay}"
                                IsClosable="{x:Bind ViewModel.MainInfoBar.IsClosable, Mode=OneWay}"
                                Message="{x:Bind ViewModel.MainInfoBar.Message, Mode=OneWay}"
                                Severity="{x:Bind ViewModel.MainInfoBar.Severity, Mode=OneWay}"
                                Title="{x:Bind ViewModel.MainInfoBar.Title, Mode=OneWay}"
                                IsIconVisible="True" />
            <ProgressRing IsIndeterminate="True"
                          Visibility="{x:Bind ViewModel.ProgressRingVisibility, Mode=OneWay}" />
        </CCToolKit:WrapPanel>

        <!-- Inputs -->
        <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
            <StackPanel Spacing="12" Margin="0,10,0,0">

                <TextBlock Text="Migrate AppLocker to App Control (WDAC)" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Convert an existing AppLocker policy into a clean WDAC base policy plus a supplemental policy holding the migrated rules. Path rules convert cleanly; hash rules carry the AppLocker SHA256 across; publisher rules cannot become true WDAC signer rules from XML alone, so enable the file re-scan below to build faithful signer rules from the referenced apps (recommended)." />

                <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
                    <Button Content="Select AppLocker policy XML" Click="{x:Bind ViewModel.BrowsePolicyButton_Click}" />
                </CCToolKit:WrapPanel>

                <TextBlock Text="{x:Bind ViewModel.SelectedPolicyPath, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Supplemental policy name:" VerticalAlignment="Center" />
                    <TextBox MinWidth="320" Text="{x:Bind ViewModel.SupplementalPolicyName, Mode=TwoWay}" />
                </StackPanel>

                <!-- Base policy options -->
                <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="20" VerticalSpacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Base policy:" VerticalAlignment="Center" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.BasePolicyModeIndex, Mode=TwoWay}" MinWidth="260">
                            <ComboBoxItem Content="Generate AllowMicrosoft base" />
                            <ComboBoxItem Content="Generate DefaultWindows base" />
                            <ComboBoxItem Content="Use an existing base policy file" />
                        </ComboBox>
                        <Button Content="Select base policy XML" Click="{x:Bind ViewModel.BrowseExistingBaseButton_Click}" />
                    </StackPanel>

                    <CheckBox Content="Audit mode (nothing blocked; logs only)" IsChecked="{x:Bind ViewModel.AuditMode, Mode=TwoWay}" />
                    <CheckBox Content="Degrade publisher rules to FileName rules (XML-only)" IsChecked="{x:Bind ViewModel.DegradePublisherRules, Mode=TwoWay}" />
                </CCToolKit:WrapPanel>

                <TextBlock Text="{x:Bind ViewModel.ExistingBasePolicyPath, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <!-- Scan-upgrade options -->
                <CheckBox Content="Re-scan files to build faithful WDAC signer/hash rules (recommended)"
                          IsChecked="{x:Bind ViewModel.ScanUpgradeEnabled, Mode=TwoWay}" />

                <ContentControl HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.ScanUpgradeEnabled, Mode=OneWay}">
                    <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
                        <Button Content="Select folders to scan" Click="{x:Bind ViewModel.SelectScanFoldersButton_Click}" />
                        <Button Content="Clear folders" Click="{x:Bind ViewModel.ClearScanFolders_Click}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="220">
                            <TextBlock Text="Threads:" VerticalAlignment="Center" />
                            <Slider Minimum="1" Maximum="16" Width="140"
                                    Value="{x:Bind ViewModel.ScalabilityValue, Mode=TwoWay}" />
                        </StackPanel>
                    </CCToolKit:WrapPanel>
                </ContentControl>

                <ListView ItemsSource="{x:Bind ViewModel.ScanFolderPaths, Mode=OneWay}" MaxHeight="120"
                          Visibility="{x:Bind ViewModel.ScanUpgradeEnabled, Mode=OneWay}"
                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- Actions -->
                <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
                    <Button Content="Convert" Style="{StaticResource AccentButtonStyle}"
                            Click="{x:Bind ViewModel.ConvertButton_Click}" />
                    <Button Content="Save base policy" Click="{x:Bind ViewModel.SaveBasePolicy_Click}"
                            IsEnabled="{x:Bind ViewModel.OutputActionsEnabled, Mode=OneWay}" />
                    <Button Content="Save supplemental policy" Click="{x:Bind ViewModel.SaveSupplementalPolicy_Click}"
                            IsEnabled="{x:Bind ViewModel.OutputActionsEnabled, Mode=OneWay}" />
                    <Button Content="Open supplemental in editor" Click="{x:Bind ViewModel.OpenSupplementalPolicy_Click}"
                            IsEnabled="{x:Bind ViewModel.OutputActionsEnabled, Mode=OneWay}" />
                </CCToolKit:WrapPanel>

                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
            </StackPanel>
        </ContentControl>

        <!-- Summary -->
        <TextBlock Grid.Row="2" Margin="0,10,0,6" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />

        <!-- Report -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.ReportNotes, Mode=OneWay}"
                  SelectionMode="Extended" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rule" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Collection / Type" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Action" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Outcome" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Detail" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="applocker:RuleMigrationNote">
                    <Grid Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind RuleName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Collection}" />
                            <TextBlock Text="{x:Bind RuleType}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Action}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind OutcomeText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Detail}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>
