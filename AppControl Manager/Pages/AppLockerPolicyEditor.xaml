<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppControlManager.Pages.AppLockerPolicyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    xmlns:vm="using:AppControlManager.ViewModels">

    <Grid Margin="15" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CCToolKit:WrapPanel Grid.Row="0" HorizontalAlignment="Center" HorizontalSpacing="15" VerticalSpacing="10">
            <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.MainInfoBar.IsOpen, Mode=TwoWay}"
                                IsClosable="{x:Bind ViewModel.MainInfoBar.IsClosable, Mode=OneWay}"
                                Message="{x:Bind ViewModel.MainInfoBar.Message, Mode=OneWay}"
                                Severity="{x:Bind ViewModel.MainInfoBar.Severity, Mode=OneWay}"
                                Title="{x:Bind ViewModel.MainInfoBar.Title, Mode=OneWay}"
                                IsIconVisible="True" />
            <ProgressRing IsIndeterminate="True"
                          Visibility="{x:Bind ViewModel.ProgressRingVisibility, Mode=OneWay}" />
        </CCToolKit:WrapPanel>

        <!-- Toolbar -->
        <CCToolKit:WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
            <Button Content="Open policy" Click="{x:Bind ViewModel.BrowseAndLoad}" />
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="{x:Bind ViewModel.Save}" />
            <Button Content="Save as..." Click="{x:Bind ViewModel.SaveAs}" />
            <Button Content="Delete selected" Click="{x:Bind ViewModel.DeleteSelectedRule}" />
            <Button Content="Add from templates">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10" MinWidth="380" MaxWidth="440">
                            <TextBlock Text="Quick rules" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <ComboBox Header="Category" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind ViewModel.TemplateCategoryFilterIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="Windows script hosts &amp; LOLBins" />
                                <ComboBoxItem Content="Torrent clients" />
                                <ComboBoxItem Content="Remote-access tools" />
                            </ComboBox>
                            <ComboBox Header="Action / scope" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind ViewModel.TemplateActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Allow - Everyone" />
                                <ComboBoxItem Content="Allow - Administrators only (blocks standard users)" />
                                <ComboBoxItem Content="Deny - Everyone" />
                            </ComboBox>
                            <ScrollViewer MaxHeight="340">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleTemplates, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AppLockerTemplateChoice">
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,3">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Add selected" Style="{StaticResource AccentButtonStyle}"
                                    Click="{x:Bind ViewModel.AddSelectedTemplates}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Add from app...">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10" MinWidth="340">
                            <TextBlock Text="Create a rule from an app" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Reads the app's publisher, product name, binary name, version and hash - the same way Simulation does - and builds a rule you can then fine-tune below."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox Header="Rule type" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind ViewModel.FileRefRuleTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Auto (publisher if signed, else hash)" />
                                <ComboBoxItem Content="Publisher" />
                                <ComboBoxItem Content="Path" />
                                <ComboBoxItem Content="Hash" />
                            </ComboBox>
                            <ComboBox Header="Action / scope" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind ViewModel.FileRefActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Allow - Everyone" />
                                <ComboBoxItem Content="Allow - Administrators only (blocks standard users)" />
                                <ComboBoxItem Content="Deny - Everyone" />
                            </ComboBox>
                            <Button Content="Pick file(s) and add" Style="{StaticResource AccentButtonStyle}"
                                    Click="{x:Bind ViewModel.AddRuleFromFile}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="SID legend">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="8" MinWidth="420" MaxWidth="480">
                            <TextBlock Text="Common security identifiers" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Click 'Use' to set the selected rule's User or group SID."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ScrollViewer MaxHeight="380">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CommonSids}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SidInfo">
                                            <Grid Padding="0,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock>
                                                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                        <Run Text="{x:Bind Sid}" FontFamily="Consolas"
                                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Use" VerticalAlignment="Center"
                                                        Click="SidApply_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock Text="{x:Bind ViewModel.SelectedPolicyPath, Mode=OneWay}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </CCToolKit:WrapPanel>

        <!-- Filters + add -->
        <CCToolKit:WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalSpacing="12" VerticalSpacing="10" VerticalAlignment="Center">
            <ComboBox Header="Collection" SelectedIndex="{x:Bind ViewModel.CollectionFilterIndex, Mode=TwoWay}" MinWidth="120">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Appx" />
                <ComboBoxItem Content="Dll" />
                <ComboBoxItem Content="Exe" />
                <ComboBoxItem Content="Msi" />
                <ComboBoxItem Content="Script" />
            </ComboBox>
            <ComboBox Header="Kind" SelectedIndex="{x:Bind ViewModel.KindFilterIndex, Mode=TwoWay}" MinWidth="120">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Publisher" />
                <ComboBoxItem Content="Path" />
                <ComboBoxItem Content="Hash" />
            </ComboBox>
            <TextBox Header="Search" PlaceholderText="name, path, id..."
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <ComboBox Header="Add to" SelectedIndex="{x:Bind ViewModel.AddCollectionIndex, Mode=TwoWay}" MinWidth="110">
                    <ComboBoxItem Content="Appx" />
                    <ComboBoxItem Content="Dll" />
                    <ComboBoxItem Content="Exe" />
                    <ComboBoxItem Content="Msi" />
                    <ComboBoxItem Content="Script" />
                </ComboBox>
                <ComboBox Header="New rule" SelectedIndex="{x:Bind ViewModel.AddKindIndex, Mode=TwoWay}" MinWidth="120">
                    <ComboBoxItem Content="Publisher" />
                    <ComboBoxItem Content="Path" />
                    <ComboBoxItem Content="Hash" />
                </ComboBox>
                <Button Content="Add rule" VerticalAlignment="Bottom" Click="{x:Bind ViewModel.AddRule}" />
            </StackPanel>
        </CCToolKit:WrapPanel>

        <!-- Master + detail -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Coll." FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Action" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Name / Condition" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppLockerRuleRow">
                        <Grid Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind CollectionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind KindText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ConditionSummary}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ExceptionsBadge}" FontSize="11"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detail editor -->
            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.DetailPaneVisibility, Mode=OneWay}">
                <StackPanel Spacing="10" Padding="4">
                    <TextBlock Text="Rule details" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBox Header="Name" Text="{x:Bind ViewModel.SelectedRow.Name, Mode=TwoWay}" />
                    <TextBox Header="Description" Text="{x:Bind ViewModel.SelectedRow.Description, Mode=TwoWay}"
                             TextWrapping="Wrap" AcceptsReturn="True" />
                    <ComboBox Header="Action" SelectedIndex="{x:Bind ViewModel.SelectedRow.ActionIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Allow" />
                        <ComboBoxItem Content="Deny" />
                    </ComboBox>
                    <StackPanel Spacing="2">
                        <TextBox Header="User or group SID"
                                 Text="{x:Bind ViewModel.SelectedRow.UserOrGroupSid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Resolves to:" />
                            <Run Text="{x:Bind ViewModel.SelectedRow.ResolvedSidName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Publisher condition -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedRow.PublisherPaneVisibility, Mode=OneWay}">
                        <TextBlock Text="Publisher condition" FontWeight="SemiBold" />
                        <TextBox Header="Publisher name" Text="{x:Bind ViewModel.SelectedRow.PublisherName, Mode=TwoWay}" />
                        <TextBox Header="Product name" Text="{x:Bind ViewModel.SelectedRow.ProductName, Mode=TwoWay}" />
                        <TextBox Header="Binary name" Text="{x:Bind ViewModel.SelectedRow.BinaryName, Mode=TwoWay}" />
                        <TextBox Header="Low version" Text="{x:Bind ViewModel.SelectedRow.LowSection, Mode=TwoWay}" />
                        <TextBox Header="High version" Text="{x:Bind ViewModel.SelectedRow.HighSection, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Path condition -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedRow.PathPaneVisibility, Mode=OneWay}">
                        <TextBlock Text="Path condition" FontWeight="SemiBold" />
                        <TextBox Header="Path" Text="{x:Bind ViewModel.SelectedRow.PathValue, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>

                    <!-- Hash condition (read-only) -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedRow.HashPaneVisibility, Mode=OneWay}">
                        <TextBlock Text="Hash condition (read-only)" FontWeight="SemiBold" />
                        <TextBox Header="Hashes" Text="{x:Bind ViewModel.SelectedRow.HashSummary, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>

                    <!-- Exceptions (editable) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Exceptions" FontWeight="SemiBold" />
                        <TextBlock Text="Files matching any of these are excluded from this rule."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add path exception" Click="{x:Bind ViewModel.AddPathException}" />
                            <Button Content="Add publisher exception" Click="{x:Bind ViewModel.AddPublisherException}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedRow.ExceptionRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppLockerConditionRow">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="8" Margin="0,4">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind TypeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Remove" Click="RemoveException_Click" />
                                            </Grid>
                                            <TextBox Header="Path" Visibility="{x:Bind PathVisibility}"
                                                     Text="{x:Bind PathValue, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                                            <StackPanel Spacing="6" Visibility="{x:Bind PublisherVisibility}">
                                                <TextBox Header="Publisher name" Text="{x:Bind PublisherName, Mode=TwoWay}" />
                                                <TextBox Header="Product name" Text="{x:Bind ProductName, Mode=TwoWay}" />
                                                <TextBox Header="Binary name" Text="{x:Bind BinaryName, Mode=TwoWay}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Header="Low version" Text="{x:Bind LowSection, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="1" Header="High version" Text="{x:Bind HighSection, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBox Header="Hashes" Visibility="{x:Bind HashVisibility}" IsReadOnly="True"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Text="{x:Bind HashSummary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
