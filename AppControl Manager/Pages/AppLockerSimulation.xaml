<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppControlManager.Pages.AppLockerSimulation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    xmlns:applocker="using:AppControlManager.AppLockerPolicy">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status / progress -->
        <CCToolKit:WrapPanel Grid.Row="0" HorizontalAlignment="Center" HorizontalSpacing="15" VerticalSpacing="10">
            <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.MainInfoBar.IsOpen, Mode=TwoWay}"
                                IsClosable="{x:Bind ViewModel.MainInfoBar.IsClosable, Mode=OneWay}"
                                Message="{x:Bind ViewModel.MainInfoBar.Message, Mode=OneWay}"
                                Severity="{x:Bind ViewModel.MainInfoBar.Severity, Mode=OneWay}"
                                Title="{x:Bind ViewModel.MainInfoBar.Title, Mode=OneWay}"
                                IsIconVisible="True" />
            <ProgressRing IsIndeterminate="True"
                          Visibility="{x:Bind ViewModel.ProgressRingVisibility, Mode=OneWay}" />
        </CCToolKit:WrapPanel>

        <!-- Inputs -->
        <ContentControl Grid.Row="1" HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
        <StackPanel Spacing="12" Margin="0,10,0,0">

            <TextBlock Text="AppLocker Policy Simulation" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Select an AppLocker policy XML and the files/folders to test. Each file is reported as Allowed or Blocked as if the policy were enforced. Publisher matches are tolerant (exact subject or Organization) and per-user scoping is approximated via the Identity option below." />

            <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
                <Button Content="Select policy XML" Click="{x:Bind ViewModel.BrowsePolicyButton_Click}" />
                <Button Content="Select files" Click="{x:Bind ViewModel.SelectFilesButton_Click}" />
                <Button Content="Select folders" Click="{x:Bind ViewModel.SelectFoldersButton_Click}" />
                <Button Content="Clear policy" Click="{x:Bind ViewModel.ClearPolicy_Click}" />
                <Button Content="Clear files" Click="{x:Bind ViewModel.ClearFiles_Click}" />
                <Button Content="Clear folders" Click="{x:Bind ViewModel.ClearFolders_Click}" />
            </CCToolKit:WrapPanel>

            <TextBlock Text="{x:Bind ViewModel.SelectedPolicyPath, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="20" VerticalSpacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Evaluate as:" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{x:Bind ViewModel.IdentityModeIndex, Mode=TwoWay}" MinWidth="260">
                        <ComboBoxItem Content="All rules (machine-wide)" />
                        <ComboBoxItem Content="Standard user (Everyone-scoped rules only)" />
                        <ComboBoxItem Content="Everyone + local Administrators" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="220">
                    <TextBlock Text="Threads:" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="16" Width="140"
                            Value="{x:Bind ViewModel.ScalabilityValue, Mode=TwoWay}" />
                </StackPanel>
            </CCToolKit:WrapPanel>

            <CCToolKit:WrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10">
                <Button Content="Run simulation" Style="{StaticResource AccentButtonStyle}"
                        Click="{x:Bind ViewModel.RunSimulationButton_Click}" />
                <Button Content="Clear results" Click="{x:Bind ViewModel.ClearResults_Click}" />
                <Button Content="Export to JSON" Click="{x:Bind ViewModel.ExportToJsonButton_Click}" />
            </CCToolKit:WrapPanel>

            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
        </StackPanel>
        </ContentControl>

        <!-- Summary -->
        <TextBlock Grid.Row="2" Margin="0,10,0,6" FontWeight="SemiBold"
                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />

        <!-- Results -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="Extended" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="File" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Verdict" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Match" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Rule" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Detail" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="applocker:AppLockerSimulationOutput">
                    <Grid Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind FileName}" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Bind FilePath}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind VerdictText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind MatchText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind MatchedRuleName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SourceText}" FontSize="11" />
                            <TextBlock Text="{x:Bind Publisher}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>
