<?xml version="1.0" encoding="utf-8"?>
<customUI:ContentDialogV2
    x:Class="AppControlManager.Pages.FilePublisherRuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    Title="{x:Bind TitleString, Mode=OneWay}"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid MinWidth="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scope / explanation -->
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ScopeDescription, Mode=OneWay}" />

        <!-- Version range -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,14">

            <TextBlock Text="File version" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Match:" VerticalAlignment="Center" MinWidth="70" />
                <ComboBox MinWidth="260"
                          SelectedIndex="{x:Bind VersionModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="This version and above (default)" />
                    <ComboBoxItem Content="Exactly this version" />
                    <ComboBoxItem Content="This version and below" />
                    <ComboBoxItem Content="Custom range" />
                    <ComboBoxItem Content="Any version" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Minimum:" VerticalAlignment="Center" MinWidth="70" />
                <TextBox MinWidth="180"
                         PlaceholderText="e.g. 10.0.19041.1"
                         IsEnabled="{x:Bind MinVersionEnabled, Mode=OneWay}"
                         Text="{x:Bind MinVersionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Maximum:" VerticalAlignment="Center" MinWidth="70" />
                <TextBox MinWidth="180"
                         PlaceholderText="e.g. 10.0.19041.9999"
                         IsEnabled="{x:Bind MaxVersionEnabled, Mode=OneWay}"
                         Text="{x:Bind MaxVersionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

        </StackPanel>

        <!-- File attributes (single-selection only) -->
        <ContentControl Grid.Row="2" HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind AttributesEnabled, Mode=OneWay}">
        <StackPanel Spacing="10">

            <TextBlock Text="File attributes" FontWeight="SemiBold" />

            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The rule matches on the first attribute that has a value, in this order: Original File Name, Internal Name, File Description, Product Name. Clear a field to fall through to the next one." />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Original File Name:" VerticalAlignment="Center" MinWidth="130" />
                <TextBox MinWidth="250" Text="{x:Bind OriginalFileNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Internal Name:" VerticalAlignment="Center" MinWidth="130" />
                <TextBox MinWidth="250" Text="{x:Bind InternalNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="File Description:" VerticalAlignment="Center" MinWidth="130" />
                <TextBox MinWidth="250" Text="{x:Bind FileDescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Product Name:" VerticalAlignment="Center" MinWidth="130" />
                <TextBox MinWidth="250" Text="{x:Bind ProductNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

        </StackPanel>
        </ContentControl>

        <!-- Validation message -->
        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="{x:Bind ValidationVisibility, Mode=OneWay}"
                   Text="{x:Bind ValidationMessage, Mode=OneWay}" />

    </Grid>
</customUI:ContentDialogV2>
